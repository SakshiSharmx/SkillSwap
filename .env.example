# SkillSwap environment variables
# Copy this file to .env.local and fill in the values.

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres

# Long random secret used to sign JWT authentication cookies
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated email addresses allowed to access the admin area
ADMIN_EMAILS=admin@example.com